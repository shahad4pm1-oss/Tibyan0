# Tibyan configuration. setup.ps1 / setup.sh copy this file to .env on first run.
# .env is git-ignored: put real secrets ONLY there (or in your host's secret store). Never commit them.
# An empty value means "not set" and never crashes startup.

# ---------------------------------------------------------------- local run (used by start/stop scripts)
BACKEND_HOST=127.0.0.1                # backend bind address (127.0.0.1 = this computer only)
BACKEND_PORT=8000                     # backend URL: http://localhost:8000
FRONTEND_PORT=5173                    # frontend URL: http://localhost:5173 (if changed, add the new origin to CORS_ORIGINS below)
OPEN_BROWSER=true                     # start.ps1 opens the frontend in your browser

# ---------------------------------------------------------------- application
APP_ENV=development                   # development | test | production
# PIPELINE_VERSION is set in code; override only for experiments

# ---------------------------------------------------------------- data (paths are relative to the repository root)
DATABASE_PATH=data/indexes/tibyan.sqlite3   # built by scripts/build_corpus.py (Quran + Sahihayn + glossary samples)
# The semantic (LSA/FAISS) index files live next to the database: data/indexes/semantic.faiss etc.
FAISS_INDEX_PATH=data/indexes/tibyan.faiss  # reserved, not used

# ---------------------------------------------------------------- LLM (claim analysis). Optional.
# Leave all three empty to run in LLM_UNAVAILABLE mode: quotes, sources, context and evidence still work;
# no claim verdict is produced. Fill them in and restart to enable REAL_LLM mode (no code change).
LLM_PROVIDER=                               # gemini (Google AI Studio key) | anthropic   (test_double: tests only, refused in production)
LLM_MODEL=                            # exact model id from your provider account (e.g. as shown in Google AI Studio)
LLM_API_KEY=                          # SECRET. Only here or in a secret store. Never printed or logged.
LLM_BASE_URL=                         # empty = the provider's official endpoint
LLM_TIMEOUT_S=30                      # Gemini thinking models may need 60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=
PROMPT_VERSION=claim_analysis_v2
# Cost telemetry: USD per million tokens from the provider's current price list. Empty = no cost shown.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
# Evidence gate / strength (uncalibrated starting values)
GATE_MIN_QUOTE_TOKENS=3
STRENGTH_MIN_TOKENS_SUFFICIENT=5

# ---------------------------------------------------------------- embeddings (local, no key needed)
EMBEDDING_PROVIDER=local_lsa          # local_lsa | sentence_transformers | hash (tests only)
EMBEDDING_MODEL=char-ngram-lsa-v1
EMBEDDING_API_KEY=

# ---------------------------------------------------------------- CORS
# Comma-separated browser origins allowed to call the API. In production only https origins are honoured.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- API hardening (docs/SECURITY.md)
RATE_LIMIT_PER_MINUTE=30              # per client IP on POST /api/v1/analyze. 0 disables (not allowed in production)
TRUST_PROXY_HEADERS=false             # true only behind a proxy that sets X-Forwarded-For
MAX_BODY_BYTES=16384
REQUEST_TIMEOUT_S=45
PARAPHRASE_MODE=disabled              # experimental mode is refused in production

# ---------------------------------------------------------------- retrieval (uncalibrated starting values)
HYBRID_STRATEGY=lexical_first         # lexical_first | rrf
RRF_K=60
LEXICAL_TOP_K=20
SEMANTIC_TOP_K=20
HYBRID_TOP_N=5
PARAPHRASE_MIN_COVERAGE=0.6
PARAPHRASE_MIN_MARGIN=0.1
MIN_PARTIAL_TOKENS=2
MAX_SPAN_AYAT=3
CONTEXT_WINDOW=2

# ---------------------------------------------------------------- privacy (SP-07)
LOG_RAW_INPUT=false                   # keep false: user text is never logged

# Local tafsir commentary (one JSON file per surah); empty directory = no commentary evidence
TAFSIR_ENABLED=true
TAFSIR_DATA_DIR=data/json-data
# tabari = Tafsir al-Tabari from api.quran.com (local files as fallback); tabari_only; local = no network
TAFSIR_PROVIDER=tabari
TAFSIR_API_BASE_URL=https://api.quran.com/api/v4
TAFSIR_API_RESOURCE_ID=15
TAFSIR_API_TIMEOUT_S=6
